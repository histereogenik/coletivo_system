# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-change-me-use-at-least-32-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL usado por docker-compose.dev.yml
POSTGRES_DB=coletivo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontends locais
CORS_ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=http://localhost:4173,http://localhost:5173

# Cookies locais sem HTTPS
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax

# Segurança HTTPS desabilitada somente em desenvolvimento
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Limites da API
DRF_THROTTLE_ANON=60/min
DRF_THROTTLE_USER=600/min
DRF_THROTTLE_PUBLIC_REGISTRATION=10/min
DRF_THROTTLE_AUTH_LOGIN=10/min
DRF_THROTTLE_AUTH_REFRESH=30/min
DJANGO_AUTH_LOG_LEVEL=INFO
