# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-change-me-use-at-least-32-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL usado por docker-compose.dev.yml
POSTGRES_DB=coletivo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontends locais
CORS_ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=http://localhost:4173,http://localhost:5173

# Cookies locais sem HTTPS
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax

# Segurança HTTPS desabilitada somente em desenvolvimento
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Limites da API
DRF_THROTTLE_ANON=60/min
DRF_THROTTLE_USER=600/min
DRF_THROTTLE_PUBLIC_REGISTRATION=10/min
DRF_THROTTLE_AUTH_LOGIN=10/min
DRF_THROTTLE_AUTH_REFRESH=30/min
DJANGO_AUTH_LOG_LEVEL=INFO

# Focus NFe - use exclusivamente o token de homologação no desenvolvimento
FOCUS_NFE_ENVIRONMENT=homologation
FOCUS_NFE_TOKEN=
FOCUS_NFE_TIMEOUT_SECONDS=30
FOCUS_NFE_ALLOW_PRODUCTION=False
# Para receber webhooks, use uma URL HTTPS pública; localhost não é acessível pela Focus
FOCUS_WEBHOOK_URL=
FOCUS_WEBHOOK_SECRET=
FOCUS_WEBHOOK_AUTHORIZATION_HEADER=X-Focus-Webhook-Token
FISCAL_ISSUER_CNPJ=65766900000190
FISCAL_ISSUER_STATE=GO
FISCAL_MEAL_DESCRIPTION=REFEICAO PREPARADA
FISCAL_PACKAGE_DESCRIPTION=PACOTE DE REFEICOES PREPARADAS
FISCAL_MEAL_NCM=21069090
FISCAL_MEAL_CFOP=5101
FISCAL_MEAL_INTERSTATE_CFOP=6101
FISCAL_MEAL_INTERSTATE_NON_CONTRIBUTOR_CFOP=6107
FISCAL_ICMS_CSOSN=102
FISCAL_PIX_PAYMENT_CODE=20
FISCAL_ALLOW_PACKAGE_EMISSION=True
FISCAL_ALLOW_MANUAL_EMISSION=True
# Confirmar PIS e COFINS com a contabilidade
FISCAL_PIS_CST=
FISCAL_COFINS_CST=
# Simples Nacional não destaca IBS/CBS em 2026; manter vazio até se tornar aplicável
FISCAL_IBS_CBS_CST=
FISCAL_IBS_CBS_CLASSIFICATION=
